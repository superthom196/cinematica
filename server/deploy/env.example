# Copy to .env and fill in. .env is gitignored and should be chmod 600.
# Never commit the real values, and never put them in the Android app repo.
#
# There is nothing here for any catalogue, metadata or stream
# stream source — those are optional provider packages and add-ons now,
# installed and configured from the browser (open the server's setup URL,
# claim it with install.sh's one-time token, then add a provider per role).
# See docs/PROVIDERS.md for what's known to work. This file is only for
# settings that are genuinely local to this box.

# Network audio (sendspin_bridge.py) — play the film's soundtrack through a
# network audio player on the LAN instead of the TV's own speakers. This is the
# player's websocket URL, e.g. ws://mediabox.lan:8928/sendspin. The protocol is
# Sendspin, which is why the setting and the service are named for it.
# Empty = network audio off; the bridge idles and films use the TV's audio.
# The TV can also pick a player itself, from the ones found on the network.
# After changing it: systemctl restart cinematica-sendspin
SENDSPIN_CLIENT_URL=

# How often (minutes) followed channels are checked for new uploads.
CHANNEL_POLL_MIN=30
